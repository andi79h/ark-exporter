#!/bin/sh
# Starts ark-export with Bun or Node. ARK_EXPORT_RUNTIME may point at a specific binary
# (needed on Ubuntu 18.04, where neither is installed system-wide).
dir=$(dirname "$(readlink -f "$0")")
cli="$dir/../src/cli.ts"
if [ -n "$ARK_EXPORT_RUNTIME" ]; then
  exec "$ARK_EXPORT_RUNTIME" "$cli" "$@"
elif command -v bun >/dev/null 2>&1; then
  exec bun "$cli" "$@"
else
  exec node "$cli" "$@"
fi
