{
  "database": "@/etc/ark-rcon/db.url",
  "arkmanager": {
    "instances": "/etc/arkmanager/instances",
    "exclude": [
      "test-*"
    ],
    "defaults": {
      "role": "live",
      "externalBufferReader": true,
      "logSource": "file"
    }
  },
  "pollSeconds": 10,
  "web": {
    "listen": "127.0.0.1:8790",
    "secureCookies": false,
    "trustProxy": false
  },
  "discord": {
    "webhooks": {},
    "routes": {}
  },
  "hooks": [],
  "retentionDays": 0
}
